# AI 资讯情报官 - 环境变量配置
# 复制此文件为 .env 并填写你的 API Key

# ---------- AI 文章生成（必须） ----------
# 推荐用 DeepSeek（便宜，中文好，注册送额度）
# 注册：https://platform.deepseek.com/
# 充 10 块钱能用几个月
# OPENAI_API_KEY="sk-你的DeepSeek_API_Key"
# OPENAI_BASE_URL="https://api.deepseek.com/v1"
# LLM_MODEL="deepseek-chat"

# 或用 OpenAI
# OPENAI_API_KEY="sk-你的OpenAI_API_Key"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL="gpt-4o"

# ---------- 飞书推送（推荐，替代公众号） ----------
# 在飞书群中添加自定义机器人 Webhook，复制其 URL
# FEISHU_WEBHOOK_URL="https://open.feishu.cn/open-apis/bot/v2/hook/你的webhook_id"
